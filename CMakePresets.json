{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    }
  ]
}